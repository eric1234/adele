import 'dart:async';
import 'dart:io';
import 'dart:ui' as ui;

import 'package:code_forge/code_forge.dart';
import 'package:flutter/material.dart';
import 'package:flutter/rendering.dart';
import 'package:flutter/services.dart';

import 'smoke_settlement.dart';
import 'interactive.dart';

// Native packaging/input smoke only. This is not prepared-EVC evidence or
// compatibility acceptance; the separate default gate retains correct results.
Future<void> main(List<String> arguments) async {
  final settlement = SmokeSettlement(
    writeOutput: stdout.writeln,
    writeError: stderr.writeln,
    flushOutput: stdout.flush,
    flushError: stderr.flush,
    terminate: exit,
  );
  FlutterError.onError = (details) {
    settlement.recordFailure(
      'CODEFORGE_SMOKE_FAILED',
      details.exception,
      details.stack ?? StackTrace.current,
    );
    unawaited(settlement.settle());
  };
  ui.PlatformDispatcher.instance.onError = (error, stack) {
    settlement.recordFailure('CODEFORGE_SMOKE_FAILED', error, stack);
    unawaited(settlement.settle());
    return true;
  };
  final binding = _ProbeBinding();
  if (Platform.environment.containsKey(
    'FRB_DART_LOAD_EXTERNAL_LIBRARY_NATIVE_LIB_DIR',
  )) {
    settlement.recordFailure(
      'CODEFORGE_SMOKE_FAILED',
      StateError('The bundled smoke must not use an FRB loader override'),
      StackTrace.current,
    );
    await settlement.settle();
    return;
  }
  try {
    await RustLib.init();
  } catch (error, stack) {
    settlement.recordFailure('CODEFORGE_INIT_FAILED', error, stack);
    await settlement.settle();
    return;
  }
  stdout.writeln('CODEFORGE_FRB_INIT_RETURNED');
  try {
    final expected = File(
      '${File(Platform.resolvedExecutable).parent.path}/lib/libcode_forge.so',
    ).resolveSymbolicLinksSync();
    final mappings = <String>{};
    final mapping = RegExp(r'^\S+\s+\S+\s+\S+\s+\S+\s+\S+\s+(.+)$');
    for (final line in File('/proc/self/maps').readAsLinesSync()) {
      final path = mapping.firstMatch(line)?.group(1);
      if (path != null && path.contains('/libcode_forge.so')) {
        mappings.add(path);
      }
    }
    _require(
      mappings.length == 1 && mappings.single == expected,
      'Expected bundled $expected; actually mapped $mappings',
    );
    stdout.writeln('CODEFORGE_NATIVE_PATH=$expected');
    stdout.writeln('CODEFORGE_NATIVE_INITIALIZED');
  } catch (error, stack) {
    settlement.recordFailure('CODEFORGE_BUNDLE_FAILED', error, stack);
    await settlement.settle();
    return;
  }

  if (arguments.contains('--interactive')) {
    runInteractiveProbe();
    return;
  }

  try {
    const initial = 'abc';
    final controller = CodeForgeController();
    final undo = UndoRedoController();
    final focus = FocusNode();
    final horizontal = ScrollController();
    final vertical = ScrollController();
    final finder = FindController(controller);
    final editorKey = GlobalKey();
    final paintKey = GlobalKey();
    runApp(
      MaterialApp(
        home: Scaffold(
          body: RepaintBoundary(
            key: paintKey,
            child: CodeForge(
              key: editorKey,
              controller: controller,
              undoController: undo,
              focusNode: focus,
              horizontalScrollController: horizontal,
              verticalScrollController: vertical,
              findController: finder,
              initialText: initial,
              autoFocus: false,
              enableFolding: false,
              enableLocalSuggestions: false,
              enableKeyboardSuggestions: false,
            ),
          ),
        ),
      ),
    );
    await binding.endOfFrame;
    focus.requestFocus();
    await binding.endOfFrame;
    _require(focus.hasFocus, 'Editor did not acquire focus');
    _require(controller.text == initial, 'Initial native text mismatch');
    _require(controller.connection?.attached == true, 'No native input client');
    final client = binding.messenger.client;
    _require(client != null, 'No observed TextInput.setClient');
    _require(
      binding.messenger.deltaModel,
      'CodeForge did not enable delta input',
    );
    final advertised = binding.messenger.editingValue;
    _require(advertised != null, 'No advertised platform editing state');
    _require(
      advertised!.text == initial,
      'Unexpected initial input projection',
    );
    final selection = advertised.selection;
    _require(
      selection.isValid &&
          selection.isCollapsed &&
          selection.end <= advertised.text.length &&
          (!advertised.composing.isValid || advertised.composing.isCollapsed),
      'Initial platform selection/composition is not a valid insertion point',
    );
    final edited = advertised.text.replaceRange(
      selection.start,
      selection.end,
      'X',
    );

    // Inject the engine-to-framework protocol, not a direct controller edit.
    // The observer forwards every outgoing message to the actual embedder.
    final reply = Completer<ByteData?>();
    binding.channelBuffers.push(
      SystemChannels.textInput.name,
      SystemChannels.textInput.codec.encodeMethodCall(
        MethodCall('TextInputClient.updateEditingStateWithDeltas', [
          client,
          {
            'deltas': [
              {
                'oldText': advertised.text,
                'deltaText': 'X',
                'deltaStart': selection.start,
                'deltaEnd': selection.end,
                'selectionBase': selection.start + 1,
                'selectionExtent': selection.start + 1,
                'selectionAffinity': 'TextAffinity.downstream',
                'selectionIsDirectional': false,
                'composingBase': -1,
                'composingExtent': -1,
              },
            ],
          },
        ]),
      ),
      reply.complete,
    );
    final response = await reply.future;
    _require(response != null, 'Text input channel returned no response');
    SystemChannels.textInput.codec.decodeEnvelope(response!);
    _require(controller.text == edited, 'Platform ASCII insertion mismatch');
    _require(undo.canUndo, 'Platform insertion did not record undo');
    undo.undo();
    _require(controller.text == initial, 'ASCII undo mismatch');
    _require(undo.canRedo, 'ASCII undo did not retain redo');
    undo.redo();
    _require(controller.text == edited, 'ASCII redo mismatch');
    stdout.writeln('CODEFORGE_PLATFORM_INPUT_OK');

    await binding.endOfFrame;
    final boundary =
        paintKey.currentContext!.findRenderObject() as RenderRepaintBoundary;
    _require(boundary.hasSize && !boundary.size.isEmpty, 'Empty editor layout');
    final image = await boundary.toImage();
    _require(
      image.width > 0 && image.height > 0,
      'Empty rendered editor image',
    );
    image.dispose();
    stdout.writeln('CODEFORGE_RENDERED');

    // Dispose the entire presentation before touching owner lifetime. Merely
    // hiding the editor or disposing its controller while mounted is not proof.
    runApp(const SizedBox.shrink());
    await binding.endOfFrame;
    _require(
      editorKey.currentContext == null,
      'Editor was not fully unmounted',
    );
    _require(controller.connection?.attached != true, 'IME remained attached');
    _require(controller.text == edited && undo.canUndo, 'Owner state was lost');
    undo.undo();
    _require(controller.text == initial, 'Unmount discarded usable undo');
    undo.redo();
    _require(controller.text == edited, 'Unmount discarded usable redo');
    stdout.writeln('CODEFORGE_UNMOUNTED_OWNER_RETAINED');

    finder.dispose();
    finder.findInputFocusNode.dispose();
    finder.replaceInputFocusNode.dispose();
    horizontal.dispose();
    vertical.dispose();
    focus.dispose();
    controller.dispose();
    undo.dispose();
    stdout.writeln('CODEFORGE_NATIVE_DISPOSED');
  } catch (error, stack) {
    settlement.recordFailure('CODEFORGE_SMOKE_FAILED', error, stack);
  }
  await settlement.settle();
}

void _require(bool condition, String message) {
  if (!condition) throw StateError(message);
}

class _ProbeBinding extends WidgetsFlutterBinding {
  late final _ObservedMessenger messenger;

  @override
  BinaryMessenger createBinaryMessenger() {
    return messenger = _ObservedMessenger(super.createBinaryMessenger());
  }
}

// Record the real client ID; the test-only ID -1 is ignored in profile builds.
// This does not replace the native client or mock the platform implementation.
class _ObservedMessenger implements BinaryMessenger {
  _ObservedMessenger(this.delegate);

  final BinaryMessenger delegate;
  int? client;
  bool deltaModel = false;
  TextEditingValue? editingValue;

  @override
  Future<ByteData?>? send(String channel, ByteData? message) {
    if (channel == SystemChannels.textInput.name && message != null) {
      final call = SystemChannels.textInput.codec.decodeMethodCall(message);
      if (call.method == 'TextInput.setClient') {
        final args = call.arguments as List<dynamic>;
        client = args[0] as int;
        editingValue = null;
        deltaModel =
            (args[1] as Map<dynamic, dynamic>)['enableDeltaModel'] == true;
      } else if (call.method == 'TextInput.setEditingState') {
        editingValue = TextEditingValue.fromJSON(
          Map<String, dynamic>.from(call.arguments as Map),
        );
      } else if (call.method == 'TextInput.clearClient') {
        client = null;
        editingValue = null;
      }
    }
    return delegate.send(channel, message);
  }

  @override
  void setMessageHandler(String channel, MessageHandler? handler) {
    delegate.setMessageHandler(channel, handler);
  }

  @override
  Future<void> handlePlatformMessage(
    String channel,
    ByteData? data,
    ui.PlatformMessageResponseCallback? callback,
  ) async {
    ServicesBinding.instance.channelBuffers.push(
      channel,
      data,
      (response) => callback?.call(response),
    );
  }
}
