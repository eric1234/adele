import 'dart:async';
import 'dart:io';

import 'package:code_forge/code_forge.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';

// Only the five DEFECT expectations change. Reproducing the broken outcomes
// is not compatibility acceptance and says nothing about prepared EVC.
const _expectDefects = bool.fromEnvironment('ADELE_EXPECT_CODEFORGE_DEFECTS');

void main() {
  setUpAll(() async {
    final nativeDirectory =
        Platform.environment['FRB_DART_LOAD_EXTERNAL_LIBRARY_NATIVE_LIB_DIR'];
    if (nativeDirectory == null || nativeDirectory.isEmpty) {
      throw StateError(
        'The driver must supply the real FRB native library path',
      );
    }
    expect(File('$nativeDirectory/libcode_forge.so').existsSync(), isTrue);
    await RustLib.init();
    stdout.writeln(
      _expectDefects
          ? 'CODEFORGE_EXPECTED_DEFECTS_MODE_NOT_ACCEPTANCE'
          : 'CODEFORGE_CORRECTNESS_GATE',
    );
  });

  final samples = <String, String>{
    'empty': '',
    'LF': 'first\nsecond\n',
    'CRLF': 'first\r\nsecond\r\n',
    'tabs': '\tfirst\tvalue\n\t\tsecond\n',
    'no final newline': 'first\nlast',
    'combining marks': 'cafe\u0301\na\u0308',
    'CJK': '\u4e2d\u6587\n\u65e5\u672c\u8a9e',
    'supplementary scalar': '\u{1f600}\nab',
    'long line': List.filled(4096, '01234567').join(),
    'larger multiline': List.generate(2048, (i) => 'line $i\tvalue\n').join(),
  };
  for (final sample in samples.entries) {
    testWidgets('BASELINE native text roundtrip: ${sample.key}', (
      tester,
    ) async {
      final controller = CodeForgeController();
      try {
        controller.text = sample.value;
        expect(controller.text, sample.value);
        expect(controller.length, sample.value.runes.length);
      } finally {
        controller.dispose();
      }
    });
  }

  testWidgets(
    'BASELINE mounted delta typing, newline, tab, selection and retained undo',
    (tester) async {
      final controller = CodeForgeController();
      final undo = UndoRedoController(groupEdits: false);
      final view = _EditorView(controller, undo);
      try {
        await tester.pumpWidget(
          MaterialApp(
            home: Scaffold(body: view.widget(initialText: 'ab')),
          ),
        );
        view.focus.requestFocus();
        await tester.pump();
        expect(view.focus.hasFocus, isTrue);
        expect(tester.testTextInput.hasAnyClients, isTrue);
        expect(tester.testTextInput.setClientArgs!['enableDeltaModel'], isTrue);
        expect(controller.connection!.attached, isTrue);

        await _platformDelta(
          tester,
          oldText: 'ab',
          text: 'c',
          start: 2,
          end: 2,
          selection: const TextSelection.collapsed(offset: 3),
        );
        expect(controller.text, 'abc');
        expect(undo.canUndo, isTrue);
        undo.undo();
        expect(controller.text, 'ab');
        undo.redo();
        expect(controller.text, 'abc');

        await _platformDelta(
          tester,
          oldText: 'abc',
          text: '\n',
          start: 3,
          end: 3,
          selection: const TextSelection.collapsed(offset: 4),
        );
        expect(controller.text, 'abc\n');
        await _platformDelta(
          tester,
          oldText: 'abc\n',
          text: '\t',
          start: 4,
          end: 4,
          selection: const TextSelection.collapsed(offset: 5),
        );
        expect(controller.text, 'abc\n\t');
        await _platformDelta(
          tester,
          oldText: 'abc\n\t',
          text: '',
          start: -1,
          end: -1,
          selection: const TextSelection(baseOffset: 0, extentOffset: 2),
        );
        expect(
          controller.selection,
          const TextSelection(baseOffset: 0, extentOffset: 2),
        );
        expect(controller.text, 'abc\n\t');
        await tester.pump();
        expect(tester.takeException(), isNull);

        await tester.pumpWidget(const SizedBox.shrink());
        expect(find.byType(CodeForge), findsNothing);
        expect(controller.connection!.attached, isFalse);
        expect(controller.text, 'abc\n\t');
        expect(undo.canUndo, isTrue);
        undo.undo();
        expect(controller.text, 'abc\n');
        undo.redo();
        expect(controller.text, 'abc\n\t');
      } finally {
        await tester.pumpWidget(const SizedBox.shrink());
        view.dispose();
        controller.dispose();
        undo.dispose();
      }
    },
  );

  testWidgets('DEFECT buffered keyboard double-delete corrupts ASCII undo', (
    tester,
  ) async {
    final controller = CodeForgeController();
    final undo = UndoRedoController(groupEdits: false);
    final view = _EditorView(controller, undo);
    try {
      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(body: view.widget(initialText: 'abc')),
        ),
      );
      view.focus.requestFocus();
      await tester.pump();
      controller.setSelectionImmediately(
        const TextSelection.collapsed(offset: 0),
      );
      // No elapsed fake time between key events: both hit the same buffer.
      await tester.sendKeyEvent(LogicalKeyboardKey.delete);
      await tester.sendKeyEvent(LogicalKeyboardKey.delete);
      expect(controller.text, 'c');
      expect(undo.undoStackSize, 2);
      undo.undo();
      undo.undo();
      expect(controller.text, _expectDefects ? 'aac' : 'abc');
    } finally {
      await tester.pumpWidget(const SizedBox.shrink());
      view.dispose();
      controller.dispose();
      undo.dispose();
    }
  });

  testWidgets('DEFECT supplementary insertion undo loses adjacent scalar', (
    tester,
  ) async {
    final controller = CodeForgeController()..text = 'ab';
    final undo = UndoRedoController(groupEdits: false);
    try {
      controller.setUndoController(undo);
      controller.replaceRange(0, 0, '\u{1f600}');
      expect(controller.text, '\u{1f600}ab');
      undo.undo();
      expect(controller.text, _expectDefects ? 'b' : 'ab');
    } finally {
      controller.dispose();
      undo.dispose();
    }
  });

  testWidgets('DEFECT immediate buffered snapshot loses Unicode-adjacent LF', (
    tester,
  ) async {
    final controller = CodeForgeController()..text = '\u{1f600}\nab';
    try {
      // CodeForge's controller offsets here are scalar offsets, not UTF-16.
      controller.setSelectionImmediately(
        const TextSelection.collapsed(offset: 4),
      );
      controller.backspace();
      final immediate = controller.text;
      // Advance exactly the dependency's 100ms buffer deadline, not wall time.
      await tester.pump(const Duration(milliseconds: 100));
      final flushed = controller.text;
      expect(immediate, _expectDefects ? '\u{1f600}ab' : '\u{1f600}\na');
      expect(flushed, immediate, reason: 'Flush must not change the snapshot');
    } finally {
      controller.dispose();
    }
  });

  testWidgets('DEFECT CRLF backspace leaves a lone CR', (tester) async {
    final controller = CodeForgeController()..text = 'a\r\nb';
    try {
      controller.setSelectionImmediately(
        const TextSelection.collapsed(offset: 3),
      );
      controller.backspace();
      expect(controller.text, _expectDefects ? 'a\rb' : 'ab');
    } finally {
      controller.dispose();
    }
  });

  testWidgets('DEFECT delayed clipboard mutates after readOnly revocation', (
    tester,
  ) async {
    final requested = Completer<void>();
    final clipboard = Completer<Object?>();
    final messenger = tester.binding.defaultBinaryMessenger;
    messenger.setMockMethodCallHandler(SystemChannels.platform, (call) async {
      if (call.method == 'Clipboard.getData') {
        requested.complete();
        return clipboard.future;
      }
      return null;
    });
    final controller = CodeForgeController()..text = 'ab';
    try {
      controller.setSelectionImmediately(
        const TextSelection.collapsed(offset: 0),
      );
      final pending = controller.paste();
      await requested.future;
      controller.readOnly = true;
      clipboard.complete({'text': 'late'});
      await pending;
      expect(controller.readOnly, isTrue);
      expect(controller.text, _expectDefects ? 'lateab' : 'ab');
    } finally {
      if (!clipboard.isCompleted) clipboard.complete(null);
      messenger.setMockMethodCallHandler(SystemChannels.platform, null);
      controller.dispose();
    }
  });

  testWidgets(
    'LIMITATION simultaneous shared-controller views couple readOnly and focus',
    (tester) async {
      final controller = CodeForgeController();
      final undo = UndoRedoController(groupEdits: false);
      final first = _EditorView(controller, undo);
      final second = _EditorView(controller, undo);
      try {
        await tester.pumpWidget(
          MaterialApp(
            home: Scaffold(
              body: Row(
                children: [
                  Expanded(child: first.widget(initialText: 'abc')),
                  Expanded(child: second.widget(readOnly: true)),
                ],
              ),
            ),
          ),
        );
        expect(find.byType(CodeForge), findsNWidgets(2));
        final widgets = tester.widgetList<CodeForge>(find.byType(CodeForge));
        expect(widgets.first.readOnly, isFalse);
        expect(widgets.last.readOnly, isTrue);
        expect(controller.readOnly, isTrue);
        expect(controller.focusNode, same(second.focus));
        first.focus.requestFocus();
        await tester.pump();
        expect(first.focus.hasFocus, isTrue);
        expect(second.focus.hasFocus, isFalse);
        expect(controller.focusNode, same(second.focus));
        controller.setSelectionImmediately(
          const TextSelection.collapsed(offset: 0),
        );
        await tester.sendKeyEvent(LogicalKeyboardKey.delete);
        expect(controller.text, 'abc', reason: 'Other view imposed readOnly');
        expect(
          widgets.first.controller!.selection,
          widgets.last.controller!.selection,
          reason: 'There is one shared selection, not per-view selections',
        );
      } finally {
        await tester.pumpWidget(const SizedBox.shrink());
        first.dispose();
        second.dispose();
        controller.dispose();
        undo.dispose();
      }
    },
  );

  testWidgets('UNSAFE-USE OBSERVATION dispose does not fence replaceRange', (
    tester,
  ) async {
    final controller = CodeForgeController()..text = 'ab';
    controller.dispose();
    // Deliberate unsupported use to observe absence of a lifetime fence. This
    // does not promise that using disposed controllers is valid or safe.
    controller.replaceRange(0, 0, 'late');
    expect(controller.text, 'lateab');
  });
}

Future<void> _platformDelta(
  WidgetTester tester, {
  required String oldText,
  required String text,
  required int start,
  required int end,
  required TextSelection selection,
}) async {
  expect(tester.testTextInput.hasAnyClients, isTrue);
  final attach = tester.testTextInput.log.lastWhere(
    (call) => call.method == 'TextInput.setClient',
  );
  final client = (attach.arguments as List<dynamic>)[0] as int;
  final reply = Completer<void>();
  await tester.binding.defaultBinaryMessenger.handlePlatformMessage(
    SystemChannels.textInput.name,
    SystemChannels.textInput.codec.encodeMethodCall(
      MethodCall('TextInputClient.updateEditingStateWithDeltas', [
        client,
        {
          'deltas': [
            {
              'oldText': oldText,
              'deltaText': text,
              'deltaStart': start,
              'deltaEnd': end,
              'selectionBase': selection.baseOffset,
              'selectionExtent': selection.extentOffset,
              'selectionAffinity': 'TextAffinity.downstream',
              'selectionIsDirectional': false,
              'composingBase': -1,
              'composingExtent': -1,
            },
          ],
        },
      ]),
    ),
    (data) {
      try {
        if (data == null) throw StateError('Text input returned no envelope');
        SystemChannels.textInput.codec.decodeEnvelope(data);
        reply.complete();
      } catch (error, stack) {
        reply.completeError(error, stack);
      }
    },
  );
  await reply.future;
}

// Own view-local resources explicitly; never dispose the document while a
// CodeForge widget can still listen to it. No file or LSP configuration is used.
class _EditorView {
  _EditorView(this.controller, this.undo) : finder = FindController(controller);

  final CodeForgeController controller;
  final UndoRedoController undo;
  final FindController finder;
  final focus = FocusNode();
  final horizontal = ScrollController();
  final vertical = ScrollController();

  Widget widget({String? initialText, bool readOnly = false}) => CodeForge(
    controller: controller,
    undoController: undo,
    findController: finder,
    focusNode: focus,
    horizontalScrollController: horizontal,
    verticalScrollController: vertical,
    initialText: initialText,
    readOnly: readOnly,
    autoFocus: false,
    enableFolding: false,
    enableLocalSuggestions: false,
    enableKeyboardSuggestions: false,
  );

  void dispose() {
    finder.dispose();
    finder.findInputFocusNode.dispose();
    finder.replaceInputFocusNode.dispose();
    horizontal.dispose();
    vertical.dispose();
    focus.dispose();
  }
}
