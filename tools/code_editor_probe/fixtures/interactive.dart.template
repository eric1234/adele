import 'dart:convert';
import 'dart:io';

import 'package:code_forge/code_forge.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';

const _samples = <String, String>{
  'ASCII delete': 'abc',
  'Unicode paste': 'ab',
  'Unicode snapshot': '\u{1f600}\nab',
  'CRLF join': 'a\r\nb',
  'LF control': 'a\nb',
};

void runInteractiveProbe() {
  stdout.writeln(
    'CODEFORGE_INTERACTIVE_READY display=${Platform.environment['DISPLAY']}',
  );
  runApp(const _ProbeApp());
  WidgetsBinding.instance.addPostFrameCallback((_) {
    stdout.writeln('CODEFORGE_INTERACTIVE_RENDERED');
  });
}

class _ProbeApp extends StatefulWidget {
  const _ProbeApp();

  @override
  State<_ProbeApp> createState() => _ProbeAppState();
}

class _ProbeAppState extends State<_ProbeApp> {
  String _sample = _samples.keys.first;
  bool _groupEdits = true;
  bool _readOnly = false;
  String _observation =
      'F8: explicit snapshot of this synthetic document only.';
  GlobalKey<_DocumentState> _document = GlobalKey();

  void _reset({String? sample, bool? groupEdits}) {
    setState(() {
      _sample = sample ?? _sample;
      _groupEdits = groupEdits ?? _groupEdits;
      _document = GlobalKey();
      _observation = 'Reset with fresh controller and undo history.';
    });
  }

  void _snapshot() {
    final state = _document.currentState;
    if (state == null) return;
    final text = state.controller.text;
    final observation = jsonEncode({
      'sample': _sample,
      'groupEdits': _groupEdits,
      'widgetReadOnly': _readOnly,
      'controllerReadOnly': state.controller.readOnly,
      'text': text,
      'codeUnits': text.codeUnits,
      'rope': state.controller.rope.getText(),
      'selectionScalars': [
        state.controller.selection.baseOffset,
        state.controller.selection.extentOffset,
      ],
      'undo': state.undo.undoStack.map((edit) => edit.toString()).toList(),
      'redoCount': state.undo.redoStackSize,
    });
    // No continuous text/clipboard/global-key logging. This explicit action is
    // for synthetic probe content and is not an immediate-input timing proof.
    stdout.writeln('CODEFORGE_MANUAL_SNAPSHOT $observation');
    setState(() => _observation = observation);
  }

  @override
  Widget build(BuildContext context) {
    const identity = String.fromEnvironment(
      'ADELE_CODEFORGE_CONFIGURATION',
      defaultValue: 'unlabelled local experiment',
    );
    const flutter = String.fromEnvironment('FLUTTER_VERSION');
    return MaterialApp(
      title: 'CodeForge investigation',
      home: CallbackShortcuts(
        bindings: {const SingleActivator(LogicalKeyboardKey.f8): _snapshot},
        child: Scaffold(
          body: SafeArea(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                Padding(
                  padding: const EdgeInsets.all(12),
                  child: Text(
                    'CodeForge 10.14.0 / FRB 2.13.0 / $identity\n'
                    'Flutter $flutter / Dart ${Platform.version}\n'
                    'Synthetic text only. No files, saving, LSP, or network. '
                    'Native library identity is printed at startup.',
                  ),
                ),
                Wrap(
                  spacing: 12,
                  crossAxisAlignment: WrapCrossAlignment.center,
                  children: [
                    DropdownButton<String>(
                      value: _sample,
                      items: [
                        for (final name in _samples.keys)
                          DropdownMenuItem(value: name, child: Text(name)),
                      ],
                      onChanged: (value) {
                        if (value != null) _reset(sample: value);
                      },
                    ),
                    TextButton(onPressed: _reset, child: const Text('Reset')),
                    Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Checkbox(
                          value: _groupEdits,
                          onChanged: (value) => _reset(groupEdits: value),
                        ),
                        const Text('Group edits (default)'),
                      ],
                    ),
                    Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Checkbox(
                          value: _readOnly,
                          onChanged: (value) =>
                              setState(() => _readOnly = value!),
                        ),
                        const Text('Widget read-only'),
                      ],
                    ),
                    TextButton(
                      onPressed: _snapshot,
                      child: const Text('Snapshot (F8)'),
                    ),
                    TextButton(
                      onPressed: () async {
                        // This replaces only this display's clipboard with a
                        // known synthetic glyph; it never reads its old contents.
                        await Clipboard.setData(
                          const ClipboardData(text: '\u{1f600}'),
                        );
                        if (!mounted) return;
                        _document.currentState?.focus.requestFocus();
                      },
                      child: const Text('Copy synthetic U+1F600'),
                    ),
                  ],
                ),
                const Padding(
                  padding: EdgeInsets.all(8),
                  child: Text(
                    'Linux: Ctrl+Home / Ctrl+End, Delete / Backspace, Ctrl+V, '
                    'Ctrl+Z / Ctrl+Shift+Z. Undo until history is restored; '
                    'grouping can combine edits. F8 does not deliberately change focus. '
                    'Snapshot buttons may observe after a flush, not the timing race.',
                  ),
                ),
                Expanded(
                  child: _Document(
                    key: _document,
                    initialText: _samples[_sample]!,
                    groupEdits: _groupEdits,
                    readOnly: _readOnly,
                  ),
                ),
                SizedBox(
                  height: 140,
                  child: SingleChildScrollView(
                    padding: const EdgeInsets.all(8),
                    child: Text(
                      _observation,
                      style: const TextStyle(fontFamily: 'monospace'),
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class _Document extends StatefulWidget {
  const _Document({
    super.key,
    required this.initialText,
    required this.groupEdits,
    required this.readOnly,
  });

  final String initialText;
  final bool groupEdits;
  final bool readOnly;

  @override
  State<_Document> createState() => _DocumentState();
}

class _DocumentState extends State<_Document> {
  final controller = CodeForgeController();
  late final undo = UndoRedoController(groupEdits: widget.groupEdits);
  late final finder = FindController(controller);
  final focus = FocusNode();
  final horizontal = ScrollController();
  final vertical = ScrollController();

  @override
  Widget build(BuildContext context) => CodeForge(
    controller: controller,
    undoController: undo,
    findController: finder,
    focusNode: focus,
    horizontalScrollController: horizontal,
    verticalScrollController: vertical,
    initialText: widget.initialText,
    readOnly: widget.readOnly,
    autoFocus: true,
  );

  @override
  void dispose() {
    finder.dispose();
    finder.findInputFocusNode.dispose();
    finder.replaceInputFocusNode.dispose();
    horizontal.dispose();
    vertical.dispose();
    focus.dispose();
    controller.dispose();
    undo.dispose();
    super.dispose();
  }
}
