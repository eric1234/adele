{
  "schemaVersion": 1,
  "recordTypes": [
    {
      "id": "dev.adele.plugin.model-configuration.preset",
      "collection": "model-presets",
      "collectionLabel": "Model Presets",
      "label": "Model Preset",
      "description": "A named configuration for one model on one configured provider instance.",
      "displayField": "name",
      "formBehavior": "dev.adele.plugin.model-configuration.preset-form",
      "fields": [
        {
          "id": "name",
          "label": "Name",
          "type": "string",
          "nonBlank": true,
          "rejectAsciiControls": true,
          "required": true
        },
        {
          "id": "description",
          "label": "Description",
          "type": "string",
          "required": false
        },
        {
          "id": "model",
          "label": "Model",
          "description": "The configured provider instance and its exact model identifier.",
          "type": "struct",
          "properties": [
            {
              "id": "provider-id",
              "type": "string",
              "format": "adele-public-id",
              "maxLength": 1024
            },
            {
              "id": "model-id",
              "type": "string",
              "nonBlank": true,
              "rejectAsciiControls": true,
              "maxLength": 1024
            }
          ],
          "editor": {"extensionId": "dev.adele.plugin.model-configuration.model-reference"},
          "required": true
        },
        {
          "id": "reasoning-effort",
          "label": "Reasoning Effort",
          "description": "Provider default leaves the effort unspecified. None explicitly requests no reasoning effort.",
          "type": "enum",
          "unsetLabel": "Provider default",
          "required": false,
          "options": [
            {"value": "none", "label": "None"},
            {"value": "minimal", "label": "Minimal"},
            {"value": "low", "label": "Low"},
            {"value": "medium", "label": "Medium"},
            {"value": "high", "label": "High"},
            {"value": "xhigh", "label": "Extra High"},
            {"value": "max", "label": "Max"}
          ]
        }
      ]
    }
  ]
}
